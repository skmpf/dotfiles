# ===== ENVIRONMENT =====
export EDITOR=vim

# ===== ESSENTIAL ALIASES =====

# Navigation
alias l='ls -l'
alias ll='ls -la'
alias la='ls -a'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Git
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gf='git fetch -ap'
alias gpl='git pull'
alias gl='git l'
alias gd='git diff'
alias gb='git branch'
alias gco='git checkout'

# Git upstream branch syncer
# Usage: gsync master (checks out master, pull upstream, push origin)
gsync() {
 if [ -z "$1" ]; then
     echo "You must supply a branch."
     return 0
 fi
 BRANCHES=$(git branch --list $1)
 if [ ! "$BRANCHES" ] ; then
    echo "Branch $1 does not exist."
    return 0
 fi
 git checkout "$1" && \
 git pull upstream "$1" && \
 git push origin "$1"
}

# Safety nets
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -pv'

# Quick edits
alias aliases='$EDITOR ~/.aliases && source ~/.zshrc'
alias zshrc='$EDITOR ~/.zshrc && source ~/.zshrc'
alias reload='source ~/.zshrc'

# System
alias h='history'
alias j='jobs'
alias ports='lsof -i -P -n | grep LISTEN'

# Misc
alias c='clear'
alias path='echo -e ${PATH//:/\\n}'
