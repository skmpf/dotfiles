#!/usr/bin/env bash

matrix_env_set() {
  [[ -n "${MATRIX_HOMESERVER_URL:-}" && -n "${MATRIX_ACCESS_TOKEN:-}" && -n "${MATRIX_ROOM_ID:-}" ]]
}

load_matrix_env() {
  matrix_env_set && return 0

  local root=""
  if command -v git >/dev/null 2>&1; then
    root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  fi

  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)" || script_dir=""

  local candidates=("$PWD/.env")
  [[ -n "$root" ]] && candidates+=("$root/.env")
  [[ -n "$script_dir" ]] && candidates+=("$script_dir/../.env")

  local file
  for file in "${candidates[@]}"; do
    [[ -f "$file" ]] || continue
    set -a
    # shellcheck disable=SC1090
    source "$file" >/dev/null 2>&1 || true
    set +a
    matrix_env_set && return 0
  done

  return 1
}

text="${1-}"
[[ -z "$text" ]] && exit 0

load_matrix_env || exit 0
command -v jq >/dev/null 2>&1 || exit 0

if [[ -n "${MATRIX_THREAD_ID:-}" ]]; then
  payload="$(jq -n --arg body "$text" --arg root "${MATRIX_THREAD_ID}" \
    '{msgtype:"m.text", body:$body,
      "m.relates_to": {rel_type:"m.thread", event_id:$root, is_falling_back:true,
                       "m.in_reply_to":{event_id:$root}}}')"
else
  payload="$(jq -n --arg body "$text" '{msgtype:"m.text", body:$body}')"
fi

room="${MATRIX_ROOM_ID//!/%21}"
room="${room//:/%3A}"
txn="nf.$$.$(date +%s).$RANDOM"
url="${MATRIX_HOMESERVER_URL%/}/_matrix/client/v3/rooms/${room}/send/m.room.message/${txn}"
curl -sS --max-time 12 -X PUT "$url" \
  -H "Authorization: Bearer ${MATRIX_ACCESS_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$payload" >/dev/null
